{
  "name": "rendezvous",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @rendezvous/api\" \"npm run dev -w @rendezvous/web\"",
    "build": "tsc -b && npm run build:web",
    "build:web": "npm run build -w @rendezvous/web",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . && prettier --check . && node tools/check-boundaries.mjs && node tools/check-localization.mjs",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:fixture": "playwright test -c playwright.fixture.config.ts",
    "secrets:scan": "node tools/check-secrets.mjs",
    "demo:dataset": "node --import tsx --conditions development tools/demo-dataset.ts",
    "demo:preflight": "node tools/demo-preflight.mjs",
    "demo:preflight:live": "npm run demo:preflight && TUTU_LIVE_TEST=1 npm run test:live -w @rendezvous/tutu",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node tools/migrate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.2.0",
    "concurrently": "10.0.5",
    "dotenv": "17.4.2",
    "eslint": "10.8.1",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
