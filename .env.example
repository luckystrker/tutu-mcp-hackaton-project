NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# Required behind a reverse proxy so rate limits use client IPs from
# X-Forwarded-For: "true", a hop count like "1", or a CIDR list.
TRUST_PROXY=
DATABASE_URL=postgresql://rendezvous:rendezvous@localhost:5432/rendezvous
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINI_APP_SHORT_NAME=
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
PUBLIC_MINI_APP_URL=http://localhost:5173
VITE_API_MODE=http
# VITE_API_BASE_URL is empty in development because Vite proxies /api.
VITE_API_BASE_URL=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
